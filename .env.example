# Salesforce (OAuth2 Authorization Code flow via a Connected App - see README)
SF_CONSUMER_KEY=your-connected-app-consumer-key     # Connected App > Consumer Key ("Client ID")
SF_CONSUMER_SECRET=your-connected-app-consumer-secret  # Connected App > Consumer Secret ("Client Secret")
SF_DOMAIN=login                                     # "login" for prod/dev orgs, "test" for sandboxes, or your org's My Domain (e.g. "yourorg-dev-ed.my")
SF_REFRESH_TOKEN=obtained-via-scripts/sf_oauth_authorize.py  # One-time browser auth; see README

# Jira Cloud (email + API token, basic auth)
JIRA_BASE_URL=https://your-domain.atlassian.net     # Your Jira Cloud site URL
JIRA_EMAIL=your-email@example.com                   # Email address of the Jira account that owns the API token
JIRA_API_TOKEN=your-jira-api-token                  # Create at https://id.atlassian.com/manage-profile/security/api-tokens

# Gmail SMTP (app password, not your regular password) - optional, email is skipped if unset
EMAIL_SENDER=your-gmail-address@gmail.com           # Gmail address the report is sent from
EMAIL_APP_PASSWORD=your-gmail-app-password          # 16-char app password: https://myaccount.google.com/apppasswords
EMAIL_RECIPIENT=recipient@example.com               # Where the HTML report should be sent
